{
  "compilerOptions": {
    "target": "ES2021",
  "module": "node18",
  "moduleResolution": "node16",
  "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
