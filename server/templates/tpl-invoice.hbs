<html>
  <head>
    <meta charset="utf-8" />
    <style>
      body { 
        font-family: 'Arial', sans-serif; 
        margin: 30px;
        line-height: 1.4;
        color: #333;
      }
      .header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 3px solid #2c3e50;
        padding-bottom: 20px;
        margin-bottom: 30px;
      }
      .invoice-title {
        font-size: 32px;
        font-weight: bold;
        color: #2c3e50;
      }
      .invoice-number {
        text-align: right;
        font-size: 14px;
        color: #7f8c8d;
      }
      .billing-section {
        display: flex;
        justify-content: space-between;
        margin-bottom: 40px;
      }
      .bill-to, .bill-from {
        width: 45%;
      }
      .section-title {
        font-weight: bold;
        color: #2c3e50;
        border-bottom: 1px solid #bdc3c7;
        padding-bottom: 5px;
        margin-bottom: 10px;
      }
      .address {
        font-size: 13px;
        line-height: 1.5;
      }
      .invoice-details {
        background: #ecf0f1;
        padding: 15px;
        margin: 20px 0;
        border-left: 4px solid #3498db;
      }
      .details-row {
        display: flex;
        justify-content: space-between;
        margin: 5px 0;
      }
      .content {
        margin: 30px 0;
        min-height: 200px;
      }
      .table {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0;
      }
      .table th, .table td {
        border: 1px solid #bdc3c7;
        padding: 10px;
        text-align: left;
      }
      .table th {
        background: #34495e;
        color: white;
      }
      .total-section {
        text-align: right;
        margin-top: 30px;
        font-size: 16px;
        font-weight: bold;
      }
      .footer {
        margin-top: 50px;
        padding-top: 20px;
        border-top: 1px solid #bdc3c7;
        font-size: 12px;
        color: #7f8c8d;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <div class="header">
      <div class="invoice-title">INVOICE</div>
      <div class="invoice-number">
        Invoice #: {{#if invoiceNumber}}{{invoiceNumber}}{{else}}INV-001{{/if}}<br />
        Date: {{#if date}}{{date}}{{else}}{{currentDate}}{{/if}}<br />
        Due: {{#if dueDate}}{{dueDate}}{{else}}Net 30{{/if}}
      </div>
    </div>

    <div class="billing-section">
      <div class="bill-from">
        <div class="section-title">FROM:</div>
        <div class="address">
          <strong>{{sender.name}}</strong><br />
          {{#if sender.company}}{{sender.company}}<br />{{/if}}
          {{sender.address_line1}}{{#if sender.address_line2}}<br />{{sender.address_line2}}{{/if}}<br />
          {{sender.address_city}}, {{sender.address_state}} {{sender.address_zip}}<br />
          {{sender.address_country}}
        </div>
      </div>

      <div class="bill-to">
        <div class="section-title">BILL TO:</div>
        <div class="address">
          <strong>{{recipient.name}}</strong><br />
          {{#if recipient.company}}{{recipient.company}}<br />{{/if}}
          {{recipient.address_line1}}{{#if recipient.address_line2}}<br />{{recipient.address_line2}}{{/if}}<br />
          {{recipient.address_city}}, {{recipient.address_state}} {{recipient.address_zip}}<br />
          {{recipient.address_country}}
        </div>
      </div>
    </div>

    <div class="invoice-details">
      <div class="details-row">
        <span><strong>Payment Terms:</strong></span>
        <span>{{#if paymentTerms}}{{paymentTerms}}{{else}}Net 30 Days{{/if}}</span>
      </div>
      <div class="details-row">
        <span><strong>Reference:</strong></span>
        <span>{{#if reference}}{{reference}}{{else}}Service Agreement{{/if}}</span>
      </div>
    </div>

    <div class="content">
      {{{body}}}
    </div>

    <div class="total-section">
      {{#if total}}
      <div>TOTAL DUE: {{total}}</div>
      {{/if}}
    </div>

    <div class="footer">
      Thank you for your business! Please remit payment within the specified terms.
    </div>
  </body>
</html>
