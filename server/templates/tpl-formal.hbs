<html>
  <head>
    <meta charset="utf-8" />
    <style>
      body { 
        font-family: 'Times New Roman', serif; 
        margin: 60px;
        line-height: 1.6;
        color: #000;
      }
      /* Remove heavy letterhead to avoid interfering with address block */
      .sender { 
        font-size: 12px; 
        color: #333;
        margin-bottom: 30px;
      }
      .date {
        text-align: right;
        margin-bottom: 30px;
        font-size: 12px;
      }
      .recipient { 
        margin-bottom: 30px; 
        font-size: 12px;
      }
      .subject {
        font-weight: bold;
        text-decoration: underline;
        margin: 30px 0;
        text-align: center;
      }
      .content { 
        margin: 30px 0;
        text-align: justify;
        font-size: 12px;
      }
      .signature {
        margin-top: 60px;
        font-size: 12px;
      }
    </style>
  </head>
  <body>
    <!-- Reserve safe zone at top for Lob address placement (top_first_page) -->
    <div style="height:4.25in"></div>

    <!-- Sender/recipient omitted; Lob prints them in the top window. -->

    <div class="date">
      {{#if date}}{{date}}{{else}}{{currentDate}}{{/if}}
    </div>

    <!-- Recipient omitted -->

    {{#if subject}}
    <div class="subject">
      RE: {{subject}}
    </div>
    {{/if}}

    <div class="content">
      {{#if greeting}}{{greeting}}{{else}}Dear {{recipient.name}},{{/if}}<br /><br />
      
      {{{body}}}

      <br /><br />
      {{#if closing}}{{closing}}{{else}}Sincerely,{{/if}}
    </div>

    <div class="signature">
      <br /><br />
      _____________________________<br />
      {{sender.name}}{{#if sender.title}}<br />{{sender.title}}{{/if}}
    </div>
  </body>
</html>
