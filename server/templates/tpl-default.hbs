<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Business Correspondence</title>
  </head>
  <body style="font-family: Arial, sans-serif; margin: 0; line-height: 1.5; color: #333; background-color:#ffffff;">

    <!-- Content is positioned below the address window using relative top offset and fixed page margins -->
    <div style="position:relative; top:5.1in; margin:0 .6in .6in .6in; max-width:7.3in; color:#111; overflow-wrap:anywhere; word-break:normal;">
      <div style="height:6px;background:#0b57d0;border-radius:3px;margin:0 0 18px 0"></div>
      {{#if subject}}
        <h1 style="margin:0 0 10px 0;font-size:18px;letter-spacing:.2px;color:#0b57d0;">{{subject}}</h1>
      {{/if}}
      <div style="font-size:12px;color:#4b5563;margin:0 0 14px 0;">{{#if date}}{{date}}{{else}}{{currentDate}}{{/if}}</div>

      <!-- Letter Content -->
      <div style="font-size:13px; line-height:1.7; color:#1f2937; margin:0 0 22px 0;">
        {{#if greeting}}{{greeting}}{{else}}Dear {{recipient.name}},{{/if}}
        <br /><br />
        {{{body}}}
      </div>

      <div style="margin:16px 0 26px 0;padding:12px 14px;border:1px solid #e5e7eb;border-radius:6px;background:#f9fafb;color:#374151;font-size:12px;">
        <strong style="color:#111827;">Notice</strong><br/>
        Printed in full color and mailed via USPS First Class. Keep this for your records.
      </div>

      <div style="font-size:13px; color:#1f2937; margin-top:28px;">
        {{#if closing}}{{closing}}{{else}}Best regards,{{/if}}
      </div>
      <div style="margin-top:10px; font-size:14px; font-weight:bold; color:#111;">
        {{sender.name}}{{#if sender.title}}<br /><span style="font-weight:normal; color:#333;">{{sender.title}}</span>{{/if}}
      </div>
    </div>
  </body>
</html>
