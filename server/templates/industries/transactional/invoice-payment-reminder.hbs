<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="page-size" content="8.5in 11in" />
  <title>Invoice Reminder</title>
</head>
<body style="font-family: Arial, sans-serif; margin: 0; padding: 0; background-color: #f9f9f9;">

  <!-- Header -->
  <div style="background-color:#004080; color:#fff; padding:25px; text-align:center; border-bottom:4px solid #0066cc;">
    <h1 style="margin:0; font-size:24px; letter-spacing:1px;">Invoice Payment Reminder</h1>
  </div>

  <!-- Main Content -->
  <div style="background-color:#fff; margin:40px 60px; padding:40px; border:1px solid #ddd; box-shadow:0 2px 6px rgba(0,0,0,0.1);">
    <p style="font-size:16px; color:#333; margin-top:0;">Dear {{recipient_name}},</p>

    <p style="font-size:16px; color:#333;">
      This is a reminder that invoice <strong>#{{invoice_number}}</strong> totalling <strong>${{amount_due}}</strong> is due on <strong>{{due_date}}</strong>.
    </p>

    <!-- Payment CTA Box -->
    <div style="background-color:#0066cc; color:#fff; padding:25px; text-align:center; margin:35px 0; border-radius:6px;">
      <a href="{{payment_url}}" style="display:inline-block; background-color:#004080; padding:12px 25px; font-size:18px; font-weight:bold; color:#fff; text-decoration:none; border-radius:4px;">
        Pay Now
      </a>
      <p style="margin:10px 0 0; font-size:13px; color:#e6e6e6;">Secure online payment portal</p>
    </div>

    <p style="font-size:15px; color:#444; line-height:1.6;">If you have already made your payment, please disregard this notice.</p>

    <!-- Signature -->
    <div style="margin-top:50px; border-top:1px solid #ccc; padding-top:15px;">
      <p style="font-size:15px; margin:0;">Sincerely,</p>
      <p style="font-size:16px; font-weight:bold; color:#0066cc; margin:5px 0 0 0;">{{sender_name}}</p>
      <p style="font-size:14px; margin:0; color:#555;">{{company_name}}</p>
    </div>
  </div>

  <!-- Footer -->
  <div style="background-color:#f5f5f5; color:#777; padding:15px; text-align:center; font-size:12px; border-top:1px solid #ddd;">
    <p style="margin:0;">{{company_name}} • {{company_address}}</p>
  </div>
</body>
</html>
