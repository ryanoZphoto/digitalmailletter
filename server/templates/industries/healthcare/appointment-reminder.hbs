<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="page-size" content="8.5in 11in" />
  <title>Appointment Reminder</title>
</head>
<body style="margin:0; padding:0; font-family: Arial, sans-serif; background-color:#f9f9f9;">

  <!-- Header -->
  <div style="background-color:#0066cc; padding:20px; text-align:center; color:#fff;">
    <h1 style="margin:0; font-size:24px;">Upcoming Appointment Reminder</h1>
  </div>

  <!-- Main Content -->
  <div style="background-color:#fff; margin:40px 60px; padding:35px; border:2px solid #0066cc;">
    <p style="font-size:16px; color:#333;">Dear {{patient_name}},</p>

    <p style="font-size:16px; color:#333;">
      This is a reminder of your upcoming appointment with <strong>{{doctor_name}}</strong>.
    </p>

    <!-- Appointment Details Box -->
    <div style="background-color:#f1f8ff; border:2px dashed #0066cc; padding:20px; margin:20px 0;">
      <p style="margin:0; font-size:16px;">
        <strong>Date:</strong> {{appointment_date}} <br/>
        <strong>Time:</strong> {{appointment_time}} <br/>
        <strong>Location:</strong> {{clinic_address}} <br/>
      </p>
    </div>

    <p style="font-size:16px; color:#333; margin-top:20px;">
      If you need to cancel or reschedule, please call us at <strong>{{clinic_phone}}</strong>.
    </p>

    <p style="font-size:16px; color:#333;">We look forward to seeing you!</p>

    <!-- Signature -->
    <div style="margin-top:30px;">
      <p style="margin:0; font-size:16px;">Sincerely,</p>
      <p style="margin:5px 0 0 0; font-weight:bold; font-size:16px; color:#0066cc;">{{clinic_name}}</p>
    </div>
  </div>

  <!-- Footer -->
  <div style="background-color:#333; color:#fff; text-align:center; font-size:12px; padding:15px;">
    <p style="margin:0;">{{clinic_address}} • Phone: {{clinic_phone}} • {{clinic_website}}</p>
  </div>

</body>
</html>
