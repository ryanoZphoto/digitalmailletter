<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="page-size" content="6.25in 4.25in" />
  <title>Thank You</title>
</head>
<body style="margin:0; padding:0; font-family: Arial, sans-serif; background-color:#fafafa;">

  <!-- Header -->
  <div style="background-color:#0066cc; padding:30px; text-align:center; color:#fff;">
    <h1 style="margin:0; font-size:26px;">Thank You!</h1>
  </div>

  <!-- Message -->
  <div style="background-color:#fff; margin:20px; padding:25px; border:2px solid #0066cc; text-align:center;">
    <p style="font-size:18px; color:#333; margin:0 0 15px 0;">{{greeting_line}}</p>
    <p style="font-size:16px; color:#333; margin:0 0 15px 0;">{{message_body}}</p>
    
    <!-- CTA -->
    <div style="margin-top:20px; background-color:#0066cc; color:#fff; padding:15px;">
      <p style="margin:0; font-size:16px; font-weight:bold;">{{cta_text}}</p>
      <p style="margin:0; font-size:14px;">{{cta_details}}</p>
    </div>
  </div>

  <!-- Signature -->
  <div style="text-align:center; margin:20px; font-size:16px; color:#333;">
    <p style="margin:0;">Sincerely,</p>
    <p style="margin:5px 0 0; font-weight:bold; font-size:18px; color:#0066cc;">{{sender_name}}</p>
    <p style="margin:0; font-size:14px; color:#666;">{{company_name}}</p>
  </div>

  <!-- Footer -->
  <div style="background-color:#333; color:#fff; text-align:center; font-size:12px; padding:10px;">
    <p style="margin:0;">{{company_address}} • {{company_website}}</p>
  </div>

</body>
</html>
