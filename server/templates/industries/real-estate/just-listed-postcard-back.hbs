<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="page-size" content="6.25in 4.25in" />
  <title>Just Listed Back</title>
</head>
<body style="margin:0; padding:0; font-family: Arial, sans-serif; background-color:#fff;">

  <!-- Left Message Section -->
  <div style="width:60%; float:left; padding:20px;">
    <h2 style="margin-top:0; font-size:20px; color:#004080;">Your Dream Home Awaits</h2>
    <p style="font-size:14px; color:#444; line-height:1.5;">
      We’re excited to share this newly listed property with you! Don’t miss the opportunity to schedule a private showing.
    </p>
    <p style="font-size:14px; color:#444;">
      Contact {{agent_name}} today at {{agent_phone}} or visit our website for more details.
    </p>
    <p style="margin-top:20px; font-size:13px; color:#777;">
      Presented by {{company_name}}
    </p>
  </div>

  <!-- Right Address Section (Lob will render recipient address block) -->
  <div style="width:40%; float:right; height:100%; border-left:1px solid #ccc; padding:20px; text-align:center; color:#444;">
    <p style="font-size:12px; margin:0;">{{company_name}}</p>
    <p style="font-size:12px; margin:0;">{{company_address}}</p>
    <p style="font-size:12px; margin:20px 0 0;">www.example.com</p>
  </div>

</body>
</html>
