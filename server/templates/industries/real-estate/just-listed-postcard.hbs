<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="page-size" content="6.25in 4.25in" />
  <title>Just Listed</title>
</head>
<body style="margin:0; padding:0; font-family: Arial, sans-serif; background-color: #f5f5f5;">

  <!-- Hero Image -->
  <div style="margin:0; padding:0;">
    <img src="{{property_image_url}}" alt="Property Photo" style="width:100%; height:220px; object-fit:cover;" />
  </div>

  <!-- Overlay headline -->
  <div style="background-color:#111; color:#fff; padding:15px; text-align:center;">
    <h1 style="margin:0; font-size:26px; letter-spacing:1px; text-transform:uppercase;">Just Listed!</h1>
  </div>

  <!-- Property Details Card -->
  <div style="background-color:#fff; margin:20px; padding:20px; border-radius:8px; border:1px solid #eee; box-shadow:0 2px 6px rgba(0,0,0,0.1);">
    <h2 style="margin-top:0; font-size:20px; color:#222;">{{property_address}}</h2>
    <p style="margin:8px 0; font-size:14px; color:#444;">
      {{beds}} Beds • {{baths}} Baths • {{sqft}} sqft
    </p>
    <p style="margin:8px 0; font-size:18px; font-weight:bold; color:#004080;">
      ${{listing_price}}
    </p>
    <p style="margin:8px 0; font-size:14px; color:#444;">
      Open House: <strong>{{open_house_date}}</strong>
    </p>
  </div>

  <!-- Agent Info + CTA -->
  <div style="display:flex; align-items:center; justify-content:space-between; margin:20px; padding:15px; background-color:#f9f9f9; border-radius:6px; border:1px solid #ddd;">
    <div style="display:flex; align-items:center;">
      <img src="{{agent_photo}}" alt="Agent" style="width:70px; height:70px; object-fit:cover; border-radius:50%; border:2px solid #004080;" />
      <div style="margin-left:15px;">
        <p style="margin:0; font-weight:bold; color:#222;">{{agent_name}}</p>
        <p style="margin:0; font-size:13px; color:#555;">{{agent_phone}}</p>
        <p style="margin:0; font-size:13px; color:#555;">{{agent_email}}</p>
      </div>
    </div>
    <div style="text-align:center;">
      <p style="margin:0; font-size:14px; color:#222;">Scan for details</p>
      <img src="{{qr_code_url}}" alt="QR Code" style="margin-top:5px; width:70px; height:70px;" />
    </div>
  </div>

  <!-- Footer Strip -->
  <div style="background-color:#004080; color:#fff; text-align:center; padding:12px; font-size:12px; letter-spacing:0.5px;">
    <p style="margin:0;">Presented by {{company_name}}</p>
  </div>

</body>
</html>
