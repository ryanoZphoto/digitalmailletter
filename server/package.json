{
  "name": "mail-my-forms-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "prisma": "prisma",
    "db:start": "docker-compose -f docker-compose.yml up -d",
    "db:stop": "docker-compose -f docker-compose.yml down",
    "db:migrate": "npx prisma migrate dev --name init && npx prisma generate",
    "worker:debug": "node dist/worker.debug.js"
  },
  "dependencies": {
    "@prisma/client": "^5.4.0",
    "@types/cors": "^2.8.19",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "form-data": "^4.0.0",
  "i18n-iso-countries": "^7.0.0",
    "handlebars": "^4.7.8",
    "nanoid": "^5.1.6",
    "node-fetch": "^3.3.2",
    "pino": "^8.8.0",
    "prisma": "^5.4.0",
    "puppeteer": "^24.22.3",
    "stripe": "^14.0.0",
    "zod": "^3.21.4",
    "nodemailer": "^6.9.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.2"
  }
}
